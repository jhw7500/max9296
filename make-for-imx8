#!/bin/bash
[ "$SDK_LOC" ] || SDK_LOC=/shared/fsl-imx-xwayland/5.10-hardknott
[ "$SDK_NAME" ] || SDK_NAME=cortexa53-crypto-poky-linux

[ ! -e "${SDK_LOC}/environment-setup-${SDK_NAME}" ] && {
    echo "Sorry, please verify: ${SDK_LOC}/environment-setup-${SDK_NAME}"
    exit 1
}

# shellcheck disable=SC1090 # SDK setup path is selected at runtime.
. "${SDK_LOC}/environment-setup-${SDK_NAME}"

KERNEL_SRC=/opt/desktop/build-desktop/tmp/work/imx8mpevk-fsl-linux/linux-imx/5.10.35+git999-r0/linux-imx-5.10.35+git999

# unset LDFLAGS to avoid userspace flags leaking into kernel build
unset LDFLAGS

make ARCH=arm64 CROSS_COMPILE=aarch64-poky-linux- KERNEL_SRC="${KERNEL_SRC}" "$@"

# --- clangd: compile_commands.json 자동 갱신 ---------------------------------
# 빌드가 남긴 .cmd 파일만 파싱한다 (컴파일 없음, ~0.05초).
# 호스트 종속 경로를 담으므로 .gitignore 대상 — 각자 빌드할 때 생성된다.
# clangd 가 GCC 전용 플래그를 읽으려면 저장소의 .clangd 파일도 함께 필요하다.
_cc_rc=$?
_cc_gen="$KERNEL_SRC/scripts/clang-tools/gen_compile_commands.py"
[ -f "$_cc_gen" ] || _cc_gen=/opt/desktop/build-desktop/workspace/sources/linux-imx/scripts/clang-tools/gen_compile_commands.py
_cc_dir="$(cd "$(dirname "$0")" && pwd)"
if [ "$_cc_rc" -eq 0 ] && [ -f "$_cc_gen" ] && ! printf '%s\n' "$@" | grep -qxE 'clean|distclean'; then
    _cc_tmp="$_cc_dir/.compile_commands.json.tmp"
    if python3 "$_cc_gen" -d "$KERNEL_SRC" -o "$_cc_tmp" "$(cd "$(dirname "$0")" && pwd)" 2>/dev/null \
       && grep -q '"file"' "$_cc_tmp" 2>/dev/null; then
        mv -f "$_cc_tmp" "$_cc_dir/compile_commands.json"
        echo "compile_commands.json 갱신됨 (clangd)"
    else
        rm -f "$_cc_tmp"
        echo "compile_commands.json 갱신 실패 — 빌드 자체는 정상" >&2
    fi
fi
exit "$_cc_rc"
