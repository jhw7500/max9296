# 호스트별 빌드 경로. 이 파일을 .env 로 복사해 채운다 — .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# 한 줄에 KEY=VALUE 하나. 따옴표와 공백 없이 쓴다 (Makefile 과 셸이 함께 읽는다).

# Yocto SDK 설치 위치. ${SDK_LOC}/environment-setup-${SDK_NAME} 이 있어야 한다.
SDK_LOC=
SDK_NAME=cortexa53-crypto-poky-linux

# 커널 소스 트리 — arch/arm64/configs 가 있고 .config 는 없는 쪽.
KERNEL_SRC=

# 소스와 빌드가 나뉜 트리에서만 채운다 — .config 와 include/config/auto.conf 가
# 있는 쪽. 이렇게 찾는다:
#
#   find <yocto루트> -path '*include/config/auto.conf'
#
# 결합형 트리(배포판 linux-headers, /lib/modules/<uname -r>/build)면 비워 둔다.
KBUILD_OUTPUT=
